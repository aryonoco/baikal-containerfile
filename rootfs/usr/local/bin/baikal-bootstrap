#!/usr/bin/env php
<?php
// SPDX-License-Identifier: BSD-2-Clause
// SPDX-FileCopyrightText: 2026 Aryan Ameri <github@aryan.ameri.coffee>

// There is no shell in this image, so nothing can chain "bootstrap && serve".
// This program does the bootstrap and then REPLACES ITSELF with the server via
// pcntl_exec, so FrankenPHP inherits PID 1 and receives signals directly.
// PHP rather than shell for the same reason it would be anyway: baikal.yaml is
// YAML and symfony/yaml already ships in Baikal's vendor tree.
//
// strict_types is on, so nothing below may lean on PHP's coercions. The two
// symbols this file borrows from the image - Symfony's Yaml and the
// BAIKAL_VERSION constant - arrive from the Baikal archive at build time and
// are not in this repository; stubs/baikal-image.php declares exactly that
// surface so PHPStan checks the calls rather than skipping them.

declare(strict_types=1);

// Both of these are COPYed in from the Baikal release archive at build time, so
// either one missing means the image was assembled wrong rather than that the
// deployment is misconfigured. PHP's own include fatal names the path but says
// nothing about what the path was for, and a container that dies before its
// first line of output is the hardest kind to diagnose. Guarding the requires
// is also what lets a level-max analysis run over this file at all, on a
// machine where /var/www/baikal does not exist.
if (!is_file('/var/www/baikal/vendor/autoload.php')) {
    fail('/var/www/baikal/vendor/autoload.php is missing: this is not a complete Baikal image');
}
require '/var/www/baikal/vendor/autoload.php';

if (!is_file('/var/www/baikal/Core/Distrib.php')) {
    fail('/var/www/baikal/Core/Distrib.php is missing: this is not a complete Baikal image');
}
require '/var/www/baikal/Core/Distrib.php';   // defines BAIKAL_VERSION

use Symfony\Component\Yaml\Yaml;

const SERVER_BIN = '/usr/local/bin/frankenphp';
const CADDYFILE  = '/etc/caddy/Caddyfile';

function fail(string $msg): never {
    fwrite(STDERR, "baikal-bootstrap: $msg\n");
    exit(1);
}

function info(string $msg): void {
    fwrite(STDOUT, "baikal-bootstrap: $msg\n");
}

function env(string $name, ?string $default = null): string {
    $v = getenv($name);
    if ($v === false || $v === '') {
        if ($default === null) {
            fail("$name is required and is not set");
        }
        return $default;
    }
    return $v;
}

$configDir   = rtrim(env('BAIKAL_PATH_CONFIG', '/data/config/'), '/') . '/';
$specificDir = rtrim(env('BAIKAL_PATH_SPECIFIC', '/data/Specific/'), '/') . '/';
$configFile  = $configDir . 'baikal.yaml';
$dbFile      = $specificDir . 'db/db.sqlite';
$installLock = $specificDir . 'INSTALL_DISABLED';

foreach ([$configDir, $specificDir . 'db'] as $dir) {
    if (!is_dir($dir) && !@mkdir($dir, 0o750, true)) {
        fail("cannot create $dir - is the volume writable by uid " . getmyuid() . '?');
    }
}

$haveConfig = file_exists($configFile);
$haveDb     = file_exists($dbFile);

// A database without its config is recoverable; a config without its database
// is not, because auth_realm is baked into every stored password hash. Creating
// an empty database here would produce a service that is up, healthy and empty,
// which is strictly worse than one that refuses to start - and the next backup
// would snapshot that over the last good copy.
if ($haveConfig && !$haveDb) {
    fail("$configFile exists but $dbFile does not. Refusing to create an empty "
       . 'database beside an existing config: restore both together, they are '
       . 'one unit.');
}

if (!$haveConfig) {
    $password = env('BAIKAL_ADMIN_PASSWORD');   // no default: refuses if unset
    $realm    = env('BAIKAL_AUTH_REALM', 'BaikalDAV');

    $config = [
        'system' => [
            'configured_version'    => BAIKAL_VERSION,
            'timezone'              => env('BAIKAL_TIMEZONE', 'UTC'),
            'card_enabled'          => true,
            'cal_enabled'           => true,
            // Upstream defaults to Digest, which breaks Windows 10 clients,
            // broke DAVx5 4.5.17, and is the one auth mode a path-rewriting
            // proxy silently kills.
            'dav_auth_type'         => env('BAIKAL_DAV_AUTH_TYPE', 'Basic'),
            // sha256 of "admin:<realm>:<password>", username the literal string
            // admin. DAV users use md5 into users.digesta1 - a different scheme
            // entirely, managed through the admin UI.
            'admin_passwordhash'    => hash('sha256', 'admin:' . $realm . ':' . $password),
            'failed_access_message' => 'user %u authentication failure for Baikal',
            'auth_realm'            => $realm,
            // Empty so it is derived from the request. Setting it is for
            // sub-path mounting and is widely broken behind reverse proxies.
            'base_uri'              => '',
            // Baikal registers its iMIP mail plugin - its only outbound traffic
            // - if and only if this is non-empty, and it is non-empty in both
            // the shipped config and the installer default. Empty is what lets
            // the deployment deny all egress.
            'invite_from'           => getenv('BAIKAL_INVITE_FROM') ?: '',
        ],
        'database' => [
            'backend'        => 'sqlite',
            'sqlite_file'    => $dbFile,
            // Vestigial: a leftover from the legacy config.system.php that
            // nothing now consumes.
            'encryption_key' => '',
        ],
    ];

    file_put_contents($configFile, Yaml::dump($config, 4, 4));
    // Must stay writable on every request, not merely at install:
    // Tools::assertBaikalIsOk() checks it and Baikal refuses to serve without it.
    chmod($configFile, 0o640);
    info("wrote $configFile");
}

if (!$haveDb) {
    $schema = '/var/www/baikal/Core/Resources/Db/SQLite/db.sql';
    if (!is_readable($schema)) {
        fail("schema $schema is missing from the image");
    }
    $schemaSql = file_get_contents($schema);
    if ($schemaSql === false) {
        fail("schema $schema could not be read");
    }
    $pdo = new PDO('sqlite:' . $dbFile, null, null, [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
    ]);
    $pdo->exec($schemaSql);
    unset($pdo);
    chmod($dbFile, 0o640);
    info("created $dbFile");
}

// Its absence re-opens the unauthenticated /admin/install/ database wizard, so
// this is security state, not a convenience marker.
if (!file_exists($installLock)) {
    touch($installLock);
    info("wrote $installLock");
}

// Version drift. When BAIKAL_VERSION is newer than configured_version, Baikal
// 302s EVERY request - dav.php included - to /admin/install/ until the upgrade
// runs. For a CalDAV server that is a total outage which every client reports
// as an auth or sync failure, so clearing it here is the difference between a
// digest bump being a restart and being an incident.
$onDisk = Yaml::parseFile($configFile);
if (!is_array($onDisk) || !isset($onDisk['system']) || !is_array($onDisk['system'])) {
    fail("$configFile has no system section. Refusing to guess.");
}

$configured = $onDisk['system']['configured_version'] ?? null;

// Not merely a null check: a version that parsed as a float or a list would
// otherwise reach version_compare() and be coerced, and 0.10 is not 0.10.0.
if (!is_string($configured) || $configured === '') {
    fail("$configFile has no usable system.configured_version. Refusing to guess.");
}

if (version_compare(BAIKAL_VERSION, $configured, '>')) {
    // Upstream's VersionUpgrade::upgrade() gates every schema change on a
    // threshold at or below 0.10.0. At or above that it performs no DDL and
    // does nothing but write this key - so this is the same operation, not an
    // imitation of it. test/upstream-migrations.sh fails the build if that
    // stops being true.
    if (version_compare($configured, '0.10.0', '<')) {
        fail("configured_version $configured is below 0.10.0 and needs a real "
           . 'schema migration this image will not perform. Back up /data, then '
           . 'upgrade through Baikal 0.10.x first.');
    }
    $onDisk['system']['configured_version'] = BAIKAL_VERSION;
    file_put_contents($configFile, Yaml::dump($onDisk, 4, 4));
    info("cleared version drift: $configured -> " . BAIKAL_VERSION);
} elseif (version_compare(BAIKAL_VERSION, $configured, '<')) {
    // Baikal has no downgrade path at all.
    fail("configured_version $configured is NEWER than this image's "
       . BAIKAL_VERSION . '. Baikal cannot downgrade. Use a newer image.');
}

info('ready, Baikal ' . BAIKAL_VERSION);

// Replace this process with the server. Not a fork: pcntl_exec overlays the
// process image, so FrankenPHP becomes PID 1 and gets SIGTERM directly. No
// supervisor, no signal-forwarding wrapper, nothing left behind to reap.
pcntl_exec(SERVER_BIN, ['run', '--config', CADDYFILE]);
fail('pcntl_exec failed to start ' . SERVER_BIN);
