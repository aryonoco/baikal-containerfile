includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    phpVersion: 80500
    paths:
        - rootfs/usr/local/bin/baikal-bootstrap
        - rootfs/usr/local/bin/baikal-health
        - rootfs/usr/local/share/baikal-health/index.php
        - test/in-container.php
        - test/probe

    # Scanned for definitions, not analysed. test/probe/app.php runs beside
    # divbast/ci's core probe, and uses what it defines.
    scanFiles:
        - stubs/baikal-image.php
        - .ci/harness/probe/core.php
    dynamicConstantNames:
        - BAIKAL_VERSION
