{
	# container speaks plain HTTP over a trusted network. 
	auto_https off
	frankenphp
	log {
		output stdout
		format json
	}
}

:8080 {
	root /var/www/baikal/html

	# RFC 6764 discovery
	redir /.well-known/caldav /dav.php/ 301
	redir /.well-known/carddav /dav.php/ 301

	php_server

	log {
		output stdout
		format json
	}
}

# Internal health listener, never published.
:8081 {
	root /usr/local/share/baikal-health
	handle /healthz {
		rewrite * /index.php
		php
	}
	handle {
		respond 404
	}
}
